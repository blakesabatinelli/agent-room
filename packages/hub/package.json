{
  "name": "@agent-room/hub",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "sh ./run.sh",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/hub.mjs --external:better-sqlite3 --sourcemap --log-level=warning \"--banner:js=import { createRequire as __cr } from \\\"module\\\"; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@agent-room/shared": "workspace:*",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "esbuild": "^0.28.2"
  }
}
