# Xcode doesn't see your shell's PATH, so pick a working Node explicitly.
# Prefer ~/.local/bin/node (Node 22), then Homebrew, then anything on PATH.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.volta/bin:$PATH"
for n in "$HOME/.local/bin/node" /opt/homebrew/bin/node /usr/local/bin/node "$(command -v node)"; do
  if [ -x "$n" ] && "$n" -v >/dev/null 2>&1; then export NODE_BINARY="$n"; break; fi
done
