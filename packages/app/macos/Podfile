# Paths are literal on purpose: the monorepo keeps node_modules three levels up.
require_relative '../../../node_modules/react-native-macos/scripts/react_native_pods'

prepare_react_native_project!

target 'AgentRoom-macOS' do
  platform :macos, '14.0'
  use_native_modules!

  # 4.7: Sparkle 2, the auto-updater for Developer ID apps. Only when AGENT_ROOM_SPARKLE=1 (scripts/package-mac.sh --release sets it), so
  # day-to-day builds don't need it. AppDelegate.mm and HubLauncher.m use it only when the build also defines AR_SPARKLE=1 (the release
  # script passes that to xcodebuild). The version is the 2.x line; scripts/make-appcast.sh uses this pod's own sign_update.
  pod 'Sparkle', '~> 2.6' if ENV['AGENT_ROOM_SPARKLE'] == '1'

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => '../../../node_modules/react-native-macos',
    :hermes_enabled => false,
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # No ccache: React Native's wrapper calls a bare `clang`, which follows xcode-select rather than the
    # Xcode doing the build. With two Xcodes installed that mixes one Xcode's compiler with the other's SDK.
    react_native_post_install(installer, '../../../node_modules/react-native-macos', ccache_enabled: false)

    # React Native only removes its ccache settings when ccache isn't installed, so clear them here.
    ccache_keys = %w[CC LD CXX LDPLUSPLUS CCACHE_BINARY]
    projects = installer.aggregate_targets.map(&:user_project).compact.uniq + [installer.pods_project]
    projects.each do |project|
      changed = false
      project.build_configurations.each do |config|
        ccache_keys.each do |key|
          value = config.build_settings[key]
          next unless value && (key == 'CCACHE_BINARY' || value.to_s.include?('ccache'))
          config.build_settings.delete(key)
          changed = true
        end
      end
      project.save if changed
    end

    # Debug builds: one architecture, no dSYM bundling, no indexing of library code.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        next unless config.name == 'Debug'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
        config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      end
    end
  end
end
