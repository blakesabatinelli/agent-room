<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIconFile</key>
    <string/>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>NSAppTransportSecurity</key>
    <dict>
      <key>NSAllowsArbitraryLoads</key>
      <true/>
    </dict>
    <key>NSMainStoryboardFile</key>
    <string>Main</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <key>NSSupportsSuddenTermination</key>
    <true/>
    <key>AgentRoomHubDir</key>
    <string>$(SRCROOT)/../../hub</string>
    <key>CFBundleDisplayName</key>
    <string>Agent Room</string>
    <!-- 4.7 Sparkle 2 auto-update. Both values are placeholders on purpose: scripts/package-mac.sh in release mode writes the real ones
         (AGENT_ROOM_FEED_URL, AGENT_ROOM_SPARKLE_ED_PUBLIC_KEY) into the built app and refuses to build while these are still here.
         Only read when the app is built with AR_SPARKLE=1. The hub reads SUFeedURL too, for the "new version available" banner. -->
    <key>SUFeedURL</key>
    <string>https://updates.example.invalid/agent-room/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>REPLACE_WITH_SPARKLE_PUBLIC_ED_KEY</string>
    <!-- 4.7 Where opt-in crash reports and usage counts would be sent. Empty on purpose: with no address nothing can be sent, whatever the
         switches say. scripts/package-mac.sh in release mode writes AGENT_ROOM_REPORT_URL here when the owner sets it for the build.
         AGENT_ROOM_REPORT_URL in the hub's environment overrides it. -->
    <key>AgentRoomReportURL</key>
    <string></string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <!-- Sparkle's optional "anonymous system profile" is off: the app sends nothing but the request for the appcast. -->
    <key>SUEnableSystemProfiling</key>
    <false/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
  </dict>
</plist>