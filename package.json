{
  "name": "agent-room",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "hub": "pnpm --filter @agent-room/hub dev",
    "hub:start": "pnpm --filter @agent-room/hub start",
    "icon:render": "node design/icon/render.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "control:lint": "pnpm --filter @agent-room/hub exec tsx src/control/cli.ts lint",
    "review:kill": "pnpm --filter @agent-room/hub exec tsx src/report/killReview.ts"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
